<Window x:Class="Transporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transporter"
        mc:Ignorable="d"
        Title="Главное меню"
        Width="980" Height="560"
        MinWidth="980" MinHeight="560"
        d:DesignWidth="980" d:DesignHeight="560"
        FontSize="16"
        FontFamily="pack://application:,,,/Fonts/#v_DistrictTF-Regular"      
        Background="#dddfe9"
        KeyDown="MainWindow_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0"
                    Margin="25,20,20,0" 
                    Orientation="Vertical"
                    HorizontalAlignment="Left">
            <TextBlock Height="20"   
                       TextAlignment="Left"
                       Text="Целевыми данные"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:Controller x:Name="FileFrom"
                              Margin="-2,5,0,0" 
                              GlobalWidth="134" FigureWidth="130"
                              Purpose="Action"
                              Command="Выбрать файл"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              ToolTip="Выбор Excel-файла из проводника"
                              MouseLeftButtonDown="FileFrom_MouseLeftButtonDown"/>

            <TextBlock Name="FileInfoFromTb"
                       Height="70"   
                       Margin="0,10,0,0" 
                       TextAlignment="Right"
                       Text=""
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <TextBlock Height="20"   
                       TextAlignment="Left"
                       Text="Номер ключевого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="DriverColumnFromTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                Align="Center"  
                                HorizontalAlignment="Left"
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />

            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер значимого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="MoneyColumnFromTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />
            
            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер Excel-листа"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="WorksheetColumnFromTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />
        </StackPanel>

        <DataGrid x:Name="Grid"
                  Grid.Row="0" Grid.Column="1"
                  Margin="0,20,0,65"
                  IsReadOnly="True"
                  RowDetailsVisibilityMode="Collapsed"
                  AutoGenerateColumns="False"
                  MinRowHeight="22"           
                  Background="#fff"
                  VerticalGridLinesBrush="#1c2541"
                  HorizontalGridLinesBrush="#1c2541"
                  VerticalAlignment="Stretch"
                  VirtualizingStackPanel.IsVirtualizing="False"
                  FontSize="16"
                  FontFamily="pack://application:,,,/Fonts/#v_DistrictTF-Regular">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                          Color="#568CF7"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey }" 
                          Color="#90B1F3"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Index}" 
                                    Header="№" 
                                    Width="34"/>
                <DataGridTextColumn Binding="{Binding Driver}" 
                                    Header="Целевой" 
                                    Width="2*"/>
                <DataGridTextColumn Binding="{Binding Money}" 
                                    Header="Значимый"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Column="2"
                    Margin="20,20,25,0" 
                    Orientation="Vertical"
                    HorizontalAlignment="Right">
            <TextBlock Height="20"   
                       TextAlignment="Right"
                       Text="Для переноса данных"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:Controller x:Name="FileTo"
                              Margin="-2,5,0,0" 
                              GlobalWidth="134" FigureWidth="130"
                              Purpose="Action"
                              Command="Выбрать файл"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              ToolTip="Выбор Excel-файла из проводника"
                              MouseLeftButtonDown="FileTo_MouseLeftButtonDown"/>

            <TextBlock Name="FileInfoToTb"
                       Height="70"   
                       Margin="0,10,0,0" 
                       TextAlignment="Right"
                       Text=""
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <TextBlock Height="20"   
                       TextAlignment="Left"
                       Text="Номер ключевого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
            
            <local:PlusMinusBox x:Name="DriverColumnToTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                Align="Center"  
                                HorizontalAlignment="Left"
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />

            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер значимого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="MoneyColumnToTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />

            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер Excel-листа"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="WorksheetColumnToTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />
        </StackPanel>



        <TextBlock Name="SuccessInfo" 
                   Grid.ColumnSpan="3"
                   Margin="0,0,0,25"
                   Height="20"   
                   TextWrapping="Wrap"
                   Opacity="0"               
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"/>


        <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                    Margin="0,0,0,20"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <local:Controller x:Name="CreateDictionary"
                              Margin="0,0,0,0"
                              GlobalWidth="134" FigureWidth="130"
                              Purpose="Action"                      
                              Command="Считать файл"
                              MouseLeftButtonDown="CreateDictionary_MouseLeftButtonDown" />
            
            <local:Controller x:Name="Transfer"
                              Margin="10,0,0,0"
                              GlobalWidth="134" FigureWidth="130"
                              Purpose="Action"                      
                              Command="Преобразовать"
                              MouseLeftButtonDown="Transfer_MouseLeftButtonDown" />
        </StackPanel>
       

        <!--<TextBlock Name="SelectedFolder"
                   Grid.Row="2" 
                   Margin="25,25,0,25"
                   Text="Папка не выбрана"
                   Height="24"  
                   HorizontalAlignment="Left"
                   TextAlignment="Left" />-->
    </Grid>
</Window>
