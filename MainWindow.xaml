<Window x:Class="Transporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transporter"
        mc:Ignorable="d"
        Title="Главное меню"
        Width="600" Height="600"
        MinWidth="600" MinHeight="600"
        d:DesignWidth="600" d:DesignHeight="600"
        FontFamily="v_DistrictTF-Regular" FontSize="16"
        Background="#dddfe9"
        KeyDown="MainWindow_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0"
                    Margin="0,25,0,0" 
                    Orientation="Vertical"
                    HorizontalAlignment="Center">
            <TextBlock Height="20"   
                       TextAlignment="Left"
                       Text="Файл с целевыми данными"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:Controller x:Name="FileFrom"
                              Margin="0,10,0,0" 
                              GlobalWidth="134" FigureWidth="130"
                              Purpose="Action"
                              Command="Выбрать файл"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              ToolTip="Выбор Excel-файла из проводника"
                              MouseLeftButtonDown="FileFrom_MouseLeftButtonDown"/>

            <TextBlock Name="FileInfoFromTb"
                       Height="70"   
                       Margin="0,10,0,0" 
                       TextAlignment="Right"
                       Text="Имя"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <TextBlock Height="20"   
                       TextAlignment="Left"
                       Text="Номер ключевого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="DriverColumnFromTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                Align="Center"  
                                HorizontalAlignment="Left"
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />

            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер значимого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="MoneyColumnFromTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />
            
            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер Excel-листа"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="WorksheetColumnFromTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="0,25,0,0" 
                    Orientation="Vertical"
                    HorizontalAlignment="Center">
            <TextBlock Height="20"   
                       TextAlignment="Right"
                       Text="Файл для переноса данных"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:Controller x:Name="FileTo"
                              Margin="0,10,0,0" 
                              GlobalWidth="134" FigureWidth="130"
                              Purpose="Action"
                              Command="Выбрать файл"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              ToolTip="Выбор Excel-файла из проводника"
                              MouseLeftButtonDown="FileTo_MouseLeftButtonDown"/>

            <TextBlock Name="FileInfoToTb"
                       Height="70"   
                       Margin="0,10,0,0" 
                       TextAlignment="Right"
                       Text="Имя"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <TextBlock Height="20"   
                       TextAlignment="Left"
                       Text="Номер ключевого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
            
            <local:PlusMinusBox x:Name="DriverColumnToTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                Align="Center"  
                                HorizontalAlignment="Left"
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />

            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер значимого столбца"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="MoneyColumnToTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />

            <TextBlock Height="20"
                       Margin="0,10,0,0" 
                       TextAlignment="Left"
                       Text="Номер Excel-листа"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>

            <local:PlusMinusBox x:Name="WorksheetColumnToTB" 
                                Margin="0,5,0,0"
                                GlobalWidth="200"
                                HorizontalAlignment="Left"
                                Align="Center"  
                                FillColor="#aec2eb" 
                                StartColor="#aec2eb" 
                                HoverColor="#87abf4" />
        </StackPanel>



        <TextBlock Name="AddSuccess" 
                   Margin="15,0,0,0"
                   Text="Чтение успешно"
                   TextWrapping="Wrap"
                   Foreground="#FF66C17E"
                   Opacity="0"               
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"/>

        <TextBlock Name="AddError" 
                   Margin="15,0,0,0"
                   Text="Чтение с ошибкой"
                   TextWrapping="Wrap"
                   Foreground="#FFF96E7C"
                   Opacity="0"                 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"/>



        <!--Внизу-->
        <local:Controller x:Name="Transfer"
                          Grid.ColumnSpan="2"
                          Margin="0,0,15,0"
                          GlobalWidth="134" FigureWidth="130"
                          Purpose="Action"                      
                          Command="Преобразовать"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          MouseLeftButtonDown="Transfer_MouseLeftButtonDown" />

        <TextBlock Name="SelectedFolder"
                   Grid.Row="2" 
                   Margin="25,25,0,25"
                   Text="Папка не выбрана"
                   Height="24"  
                   HorizontalAlignment="Left"
                   TextAlignment="Left" />
    </Grid>
</Window>
