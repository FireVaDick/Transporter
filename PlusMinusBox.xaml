<UserControl x:Class="Transporter.PlusMinusBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="120" d:DesignHeight="46"
             Width="{Binding GlobalWidth}" Height="46"  
             FontSize="18"
             FontFamily="pack://application:,,,/Fonts/#v_DistrictTF-Regular"
             HorizontalAlignment="Center" VerticalAlignment="Top" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Panel.ZIndex="2"
              Height="42"
              VerticalAlignment="Center">
            <TextBox Name="TB"
                     Text="{Binding Text}"
                     Height="40" 
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="{Binding Align}"
                     VerticalContentAlignment="Center"
                     TextChanged="TB_TextChanged"
                     PreviewTextInput="TB_PreviewTextInput"/>

            <Rectangle Name="IsEmpty" Opacity="0"
                       Margin="-1,1,-1,1" 
                       Stroke="#FFFF6C7B"
                       StrokeThickness="2"
                       VerticalAlignment="Stretch"/>
        </Grid>



        <Grid Grid.Column="1"
              Margin="0,0,0,0"
              Height="42"
              VerticalAlignment="Center">
            <Rectangle Name="Plus" 
                       Margin="0,1,0,0"
                       StrokeThickness="1"
                       Fill="{Binding FillColor}"
                       Stroke="Black"  
                       Cursor="Hand"
                       Width="26" Height="40"
                       HorizontalAlignment="Right"   
                       VerticalAlignment="Top"
                       MouseEnter="PlusMinus_MouseEnter"
                       MouseLeave="PlusMinus_MouseLeave" 
                       MouseLeftButtonDown="Plus_MouseLeftButtonDown" />

            <TextBlock Margin="0,0,0,2"
                       Text="+" FontSize="14" 
                       IsHitTestVisible="False" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Column="2" 
              Margin="-1,0,0,0"
              Height="42"
              VerticalAlignment="Center">
            <Rectangle Name="Minus" 
                       Margin="0,1,0,0"
                       StrokeThickness="1"
                       Fill="{Binding FillColor}"
                       Stroke="Black"  
                       Cursor="Hand"
                       Width="26" Height="40"
                       HorizontalAlignment="Right"   
                       VerticalAlignment="Top"
                       MouseEnter="PlusMinus_MouseEnter"
                       MouseLeave="PlusMinus_MouseLeave" 
                       MouseLeftButtonDown="Minus_MouseLeftButtonDown" />

            <TextBlock Margin="0,0,0,2"
                       Text="-" FontSize="20" 
                       IsHitTestVisible="False" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Column="3" 
              Margin="-1,0,0,0"
              Height="42"
              VerticalAlignment="Center">
            <Rectangle Name="ClearRect" 
                       Margin="0,1,0,0"
                       StrokeThickness="1"
                       Fill="{Binding FillColor}"
                       Stroke="Black"  
                       Cursor="Hand"
                       Width="26" Height="40"
                       HorizontalAlignment="Right"   
                       VerticalAlignment="Top"
                       MouseEnter="PlusMinus_MouseEnter"
                       MouseLeave="PlusMinus_MouseLeave" 
                       MouseLeftButtonDown="Clear_MouseLeftButtonDown" />

            <TextBlock Margin="0,0,0,2"
                       Text="x" FontSize="14" 
                       IsHitTestVisible="False" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

